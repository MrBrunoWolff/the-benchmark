{
  "name": "the-benchmark",
  "version": "0.3.1",
  "description": "Minimal zero-dependency benchmark for local LLM servers (LM Studio, Ollama, llama.cpp, vLLM): prefill, generation, a live concurrency sweep, and a real agentic tool-calling loop.",
  "keywords": [
    "agentic",
    "benchmark",
    "concurrency",
    "llama.cpp",
    "llm",
    "lmstudio",
    "ollama",
    "tokens-per-second",
    "vllm"
  ],
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/the-benchmark/issues"
  },
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/the-benchmark.git"
  },
  "bin": {
    "the-benchmark": "bench.mjs"
  },
  "files": [
    "bench.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "node bench.mjs",
    "concurrent": "node bench.mjs --phases concurrent",
    "gallery": "node bench.mjs --phases concurrent --scenario svg --concurrency 9",
    "agentic": "node bench.mjs --phases agentic",
    "all": "node bench.mjs --phases prefill,generation,concurrent,agentic",
    "test": "bun test",
    "build:binaries": "bun scripts/build-binaries.ts",
    "system-one": "node bench.mjs --phases system-one"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "packageManager": "bun@1.4.0"
}
